# ==============================================================================
# SmartGym AI Microservice Environment Configuration Template
# ==============================================================================

# --- 1. LLM Provider Configuration ---
# Choose your LLM Provider: 'gemini' (Recommended), 'openai', or 'mock' (Offline / Testing)
LLM_PROVIDER=gemini

# Model name:
# For Gemini: 'gemini-1.5-flash', 'gemini-1.5-pro', or 'gemini-2.0-flash'
# For OpenAI: 'gpt-4o', 'gpt-4o-mini'
LLM_MODEL=gemini-1.5-flash

# Paste your API Key here:
# If using Gemini (get free key from https://aistudio.google.com):
GEMINI_API_KEY=your_gemini_api_key_here

# Alternatively, if using OpenAI (https://platform.openai.com):
# OPENAI_API_KEY=sk-your_openai_api_key_here

# Generic LLM API key / Base URL (optional):
# LLM_API_KEY=
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# LLM Timeout in seconds
LLM_TIMEOUT_SECONDS=30.0

# --- 2. Governance & Human-in-the-Loop Threshold ---
# Any estimated repair exceeding this cost in LKR requires human manager sign-off
AI_APPROVAL_COST_THRESHOLD=25000.0

# --- 3. Internal Microservice Security Secret ---
# Shared secret with ASP.NET Core backend (SmartGym.Api -> AiService:ApiKey)
AI_SERVICE_API_KEY=local-dev-internal-secret-token

# --- 4. Database Persistence ---
DATABASE_URL=postgresql://postgres:1234@localhost:5432/smartgym

# --- 5. Server Runtime ---
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
