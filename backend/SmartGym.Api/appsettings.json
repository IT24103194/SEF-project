{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=smartgym;Username=postgres;Password=postgres"
  },
  "JwtSettings": {
    "Key": "ReplaceWithAStrongSecureSecretKeyAtLeast32BytesLongForProduction!",
    "Issuer": "SmartGymApi",
    "Audience": "SmartGymClients",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "AiService": {
    "BaseUrl": "http://localhost:8000",
    "ApiKey": "local-dev-internal-secret-token",
    "ApprovalCostThreshold": 25000.0,
    "MaxRetries": 3,
    "ToolTimeoutSeconds": 10
  },
  "EmailSettings": {
    "Provider": "smtp",
    "From": "notifications@smartgym.local",
    "Host": "localhost",
    "Port": 1025
  },
  "CorsOrigins": [
    "http://localhost:3000",
    "http://localhost:5173",
    "http://localhost:4173",
    "http://127.0.0.1:3000",
    "http://127.0.0.1:5173"
  ]
}
