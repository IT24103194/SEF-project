# Database Configuration (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=smartgym
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=smartgym;Username=postgres;Password=postgres

# ASP.NET Core & JWT Security
ASPNETCORE_ENVIRONMENT=Development
JWT_SECRET=ReplaceWithAStrongSecureSecretKeyAtLeast32BytesLongForProduction!
JWT_ISSUER=SmartGymApi
JWT_AUDIENCE=SmartGymClients
JWT_EXPIRY_MINUTES=60
REFRESH_TOKEN_EXPIRY_DAYS=7

# Internal Agentic AI Service
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=local-dev-internal-secret-token
AI_APPROVAL_COST_THRESHOLD=25000.0
AI_MAX_RETRIES=3
AI_TOOL_TIMEOUT_SECONDS=10
LLM_REQUEST_TIMEOUT_SECONDS=30

# LLM Provider Configuration (mock, openai, anthropic, gemini)
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o
LLM_API_KEY=
LLM_BASE_URL=

# Third-Party Transactional Email Provider
EMAIL_PROVIDER=smtp
EMAIL_API_KEY=
EMAIL_FROM=notifications@smartgym.local
SMTP_HOST=localhost
SMTP_PORT=1025

# Frontend Web & Mobile Application URLs
REACT_API_URL=http://localhost:5000/api
FLUTTER_API_URL=http://10.0.2.2:5000/api
